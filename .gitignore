# Local install state (never commit from a live machine)
home/.tmux/plugins/
home/.fzf/
home/.fzf.bash

# Per-machine fastfetch live copies (seeded from *.example.* templates)
**/custom-fetch-art.txt
**/custom-fetch-padding.jsonc
**/.custom-fetch-art.txt
