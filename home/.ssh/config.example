Host github.com
  HostName github.com
  User git
  IdentityFile ~/.ssh/id_XXXXXXXXXX
  IdentitiesOnly yes

# Defaults last (OpenSSH uses the first value per option).
Host *
  ServerAliveInterval 60
  ServerAliveCountMax 10
  IdentitiesOnly yes

# Add named hosts for fssh (fuzzy ssh picker). Example:
# Host office
#   HostName office.example.com
#   User numan
