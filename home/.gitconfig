# user.name / user.email live in ~/.gitconfig.local (not tracked, not
# auto-created -- create it yourself on each machine, e.g.:
#   [user]
#       name = Your Name
#       email = you@example.com
[include]
	path = ~/.gitconfig.local
[credential "https://github.com"]
	helper =
	helper = !gh auth git-credential
[credential "https://gist.github.com"]
	helper =
	helper = !gh auth git-credential
