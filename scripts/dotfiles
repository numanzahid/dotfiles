#!/usr/bin/env bash
# Unified dotfiles CLI. Wraps devbox.sh, desktop.sh, and server.sh.
set -euo pipefail

DOTFILES_DIR="${DOTFILES_DIR:-}"
if [[ -z "$DOTFILES_DIR" ]]; then
  if [[ -n "${BASH_SOURCE[0]:-}" && "${BASH_SOURCE[0]}" != "${0:-}" ]]; then
    _df_self="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
  else
    _df_self="$(cd "$(dirname "$0")/.." && pwd)"
  fi
  if [[ -f "$_df_self/devbox.sh" ]]; then
    DOTFILES_DIR="$_df_self"
  elif [[ -d "${HOME}/.dotfiles" && -f "${HOME}/.dotfiles/devbox.sh" ]]; then
    DOTFILES_DIR="${HOME}/.dotfiles"
  elif [[ -d "${HOME}/dotfiles" && -f "${HOME}/dotfiles/devbox.sh" ]]; then
    DOTFILES_DIR="${HOME}/dotfiles"
  fi
  unset _df_self
fi

STANDALONE_CLI_DIR="${HOME}/.install-scripts/dotfiles-cli"
if [[ -f "${DOTFILES_DIR}/scripts/lib/component-state.sh" ]]; then
  SCRIPTS_DIR="${DOTFILES_DIR}/scripts"
  LIB_DIR="$SCRIPTS_DIR/lib"
elif [[ -f "$STANDALONE_CLI_DIR/lib/component-state.sh" ]]; then
  LIB_DIR="$STANDALONE_CLI_DIR/lib"
  SCRIPTS_DIR="${DOTFILES_DIR:+$DOTFILES_DIR/scripts}"
else
  SCRIPTS_DIR="${DOTFILES_DIR}/scripts"
  LIB_DIR="$SCRIPTS_DIR/lib"
fi

# shellcheck source=lib/component-state.sh
source "$LIB_DIR/component-state.sh"
# shellcheck source=lib/platform.sh
source "$LIB_DIR/platform.sh"

DRY_RUN=0
FORCE=0
CONFIG_ONLY=0

usage() {
  cat <<'EOF'
Usage: dotfiles <command> [options]

Commands:
  update [--force] [--config-only] [--dry-run]
      Pull the dotfiles repo and refresh this machine.
      Always re-links configs (unless --config-only skips software only).
      Software is updated when last run was more than 30 days ago.
      Stops if the repo has local changes; prompts to discard and pull.
      --force discards tracked repo changes, pulls, and reinstalls all
      software (full install, ignores the 30-day skip).

  status
      Profile, nvim, fetch, installed tools, versions, and last-updated times.

  install <what>
      lazyvim       Full LazyVim profile
      lazyvim-lite  Editor-only LazyVim
      fetch         Fastfetch banner (interactive art picker)

  uninstall
      Interactive undo: dry-run, uninstall, or purge (removes clone and state).

First-time setup (before dotfiles is on PATH):
  ./devbox.sh          Debian/Ubuntu full install
  ./desktop.sh         Fedora full install
  ./server.sh          Server / VPS full install

Single-tool upgrades: ./scripts/<tool>-install-update.sh
EOF
}

log() {
  printf '[dotfiles] %s\n' "$*"
}

die() {
  printf '[dotfiles] ERROR: %s\n' "$*" >&2
  exit 1
}

require_dotfiles_dir() {
  [[ -n "$DOTFILES_DIR" && -d "$DOTFILES_DIR" ]] ||
    die "dotfiles repo not found at ~/.dotfiles (clone the repo first)"
}

run_installer() {
  if [[ "$DRY_RUN" -eq 1 ]]; then
    printf '+'
    printf ' %q' "$@"
    printf '\n'
  else
    "$@"
  fi
}

dotfiles_show_repo_dirty() {
  local has_unstaged=0 has_staged=0

  git diff --quiet --exit-code || has_unstaged=1
  git diff --cached --quiet --exit-code || has_staged=1

  log "local changes in $DOTFILES_DIR:"
  git status --short
  if [[ "$has_unstaged" -eq 1 ]]; then
    printf '\n'
    log "unstaged diff:"
    git diff --stat
  fi
  if [[ "$has_staged" -eq 1 ]]; then
    printf '\n'
    log "staged diff:"
    git diff --cached --stat
  fi
  printf '\n'
}

dotfiles_repo_is_dirty() {
  ! git diff --quiet --exit-code || ! git diff --cached --quiet --exit-code
}

dotfiles_prompt_discard_dirty() {
  local answer
  dotfiles_show_repo_dirty
  printf 'Discard local changes and pull? [y/N] '
  read -r answer
  case "$answer" in
    y | Y | yes | YES) return 0 ;;
    *) return 1 ;;
  esac
}

dotfiles_repo_sync() {
  local force="$1"

  require_dotfiles_dir
  cd "$DOTFILES_DIR"

  if ! git rev-parse --is-inside-work-tree >/dev/null 2>&1; then
    die "not a git repository: $DOTFILES_DIR"
  fi

  if [[ "$force" -eq 1 ]]; then
    log "discarding tracked repo changes (--force)"
    if [[ "$DRY_RUN" -eq 1 ]]; then
      log "would run: git reset --hard HEAD"
    else
      git reset --hard HEAD
    fi
  elif dotfiles_repo_is_dirty; then
    if ! dotfiles_prompt_discard_dirty; then
      die "stopped: repo has local changes"
    fi
    log "discarding tracked repo changes"
    if [[ "$DRY_RUN" -eq 1 ]]; then
      log "would run: git reset --hard HEAD"
    else
      git reset --hard HEAD
    fi
  fi

  log "pulling latest dotfiles"
  if [[ "$DRY_RUN" -eq 1 ]]; then
    log "would run: git pull --ff-only"
  else
    git pull --ff-only
    df_component_touch repo "$(df_component_detect_version repo)"
  fi
}

dotfiles_profile_script() {
  local profile="$1"
  case "$profile" in
    devbox) printf '%s/devbox.sh\n' "$DOTFILES_DIR" ;;
    desktop) printf '%s/desktop.sh\n' "$DOTFILES_DIR" ;;
    server) printf '%s/server.sh\n' "$DOTFILES_DIR" ;;
    *)
      die "unknown profile: $profile"
      ;;
  esac
}

dotfiles_run_profile_installer() {
  local mode="$1"
  local profile script
  local -a args=() env_args=()

  profile="$(df_profile_detect)"
  script="$(dotfiles_profile_script "$profile")"
  [[ -x "$script" || -f "$script" ]] || die "installer missing: $script"

  case "$mode" in
    full) ;;
    configs) args=(--configs-only) ;;
    software-stale) args=(--software-only); env_args=(env DOTFILES_RESPECT_COMPONENT_AGE=1) ;;
    software-force) args=(--software-only) ;;
    *)
      die "unknown install mode: $mode"
      ;;
  esac

  if [[ "$DRY_RUN" -eq 1 ]]; then
    DRY_RUN=1 run_installer "${env_args[@]}" bash "$script" "${args[@]}"
  else
    "${env_args[@]}" bash "$script" "${args[@]}"
  fi
}

dotfiles_cmd_update() {
  local profile

  require_dotfiles_dir
  profile="$(df_profile_detect)"
  log "profile: $profile"

  dotfiles_repo_sync "$FORCE"

  if [[ "$CONFIG_ONLY" -eq 1 ]]; then
    dotfiles_run_profile_installer configs
  elif [[ "$FORCE" -eq 1 ]]; then
    dotfiles_run_profile_installer full
  else
    dotfiles_run_profile_installer configs
    dotfiles_run_profile_installer software-stale
  fi

  log "update finished"
}

dotfiles_cmd_status() {
  df_status_print
}

dotfiles_cmd_uninstall() {
  local script

  require_dotfiles_dir
  script="$DOTFILES_DIR/uninstall.sh"
  [[ -f "$script" ]] || die "uninstall script missing: $script"
  exec bash "$script"
}

dotfiles_cmd_install() {
  local what="${1:-}"

  require_dotfiles_dir
  [[ -n "$what" ]] || die "install requires: lazyvim, lazyvim-lite, or fetch"

  case "$what" in
    lazyvim)
      run_installer bash "$DOTFILES_DIR/lazyvim/install-lazyvim.sh"
      [[ "$DRY_RUN" -eq 1 ]] || df_component_touch lazyvim "$(df_component_detect_version lazyvim)"
      ;;
    lazyvim-lite)
      run_installer bash "$DOTFILES_DIR/lazyvim-lite/install-lazyvim-lite.sh"
      [[ "$DRY_RUN" -eq 1 ]] || df_component_touch lazyvim-lite "$(df_component_detect_version lazyvim-lite)"
      ;;
    fetch)
      run_installer bash "$DOTFILES_DIR/install-fetch.sh"
      [[ "$DRY_RUN" -eq 1 ]] || df_component_touch fetch ""
      ;;
    *)
      die "unknown install target: $what (try: lazyvim, lazyvim-lite, fetch)"
      ;;
  esac
}

main() {
  local cmd="${1:-}"

  if [[ -z "$cmd" ]]; then
    usage
    exit 0
  fi

  shift || true
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --dry-run) DRY_RUN=1 ;;
      --force) FORCE=1 ;;
      --config-only) CONFIG_ONLY=1 ;;
      -h | --help)
        usage
        exit 0
        ;;
      *)
        break
        ;;
    esac
    shift
  done

  export DRY_RUN

  case "$cmd" in
    update) dotfiles_cmd_update ;;
    status) dotfiles_cmd_status ;;
    uninstall) dotfiles_cmd_uninstall ;;
    install) dotfiles_cmd_install "$@" ;;
    -h | --help)
      usage
      exit 0
      ;;
    *)
      die "unknown command: $cmd (try: update, status, install, uninstall)"
      ;;
  esac
}

main "$@"
